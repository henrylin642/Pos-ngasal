// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  users     User[]
  categories Category[]
  menuItems MenuItem[]
  orders    Order[]
  noteOptions NoteOption[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  username  String
  password  String
  role      String   // FRONT, KITCHEN, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, username])
}

model Category {
  id        Int        @id @default(autoincrement())
  storeId   Int
  store     Store      @relation(fields: [storeId], references: [id])
  name      String
  items     MenuItem[]
  noteOptions NoteOption[]
  sortOrder Int        @default(0)
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  price       Float
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  description String?
  imageUrl    String?
  isAvailable Boolean  @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id          Int         @id @default(autoincrement())
  storeId     Int
  store       Store       @relation(fields: [storeId], references: [id])
  tableNumber String?     // Nullable for Takeout
  type        String      // DINE_IN, TAKE_OUT
  status      String      // PENDING, COOKING, COMPLETED
  totalAmount Float
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  isPaid      Boolean     @default(false)
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  price      Float    // Snapshot of price at time of order
  notes      String? // Stores selected notes like "No Ice", "Extra Spicy"
  status     String   @default("PENDING") // PENDING, COOKING, COMPLETED
}

model NoteOption {
  id        Int      @id @default(autoincrement())
  storeId   Int
  store     Store    @relation(fields: [storeId], references: [id])
  label     String
  categories Category[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visitor {
  id        Int      @id @default(autoincrement())
  ip        String
  userAgent String?
  path      String?
  createdAt DateTime @default(now())
}
